generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas = ["public"]
}

// ENUMS
enum BookingStatus {
  confirmed
  cancelled
  completed
}

enum UserRole {
  guest
  member
  admin
}

enum LoyaltyPointType {
  earned
  redeemed
}

// =============================================
// CORE TABLES
// =============================================

model Apartment {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  slug            String   @unique
  name            String
  description     String
  shortDescription String?  @map("short_description")
  maxGuests       Int      @map("max_guests")
  bedrooms        Int
  basePriceCents  Int      @map("base_price_cents")
  imageUrl        String?  @map("image_url")
  galleryImages   String[] @default([]) @map("gallery_images")
  artisticFeatures String[] @default([]) @map("artistic_features")
  amenities       String[] @default([])
  locationDetails Json?    @map("location_details")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  bookings Booking[]

  @@map("apartments")
}

model Booking {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String?       @map("user_id") @db.Uuid
  apartmentId        String        @map("apartment_id") @db.Uuid
  checkInDate        DateTime      @map("check_in_date") @db.Date
  checkOutDate       DateTime      @map("check_out_date") @db.Date
  totalGuests        Int           @map("total_guests")
  status             BookingStatus @default(confirmed)
  totalCents         Int           @map("total_cents")
  specialRequests    String?       @map("special_requests")
  cancellationReason String?       @map("cancellation_reason")
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @map("updated_at") @db.Timestamptz

  apartment      Apartment       @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  loyaltyPoints  LoyaltyPoint[]

  @@map("bookings")
}

model LoyaltyPoint {
  id          String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  points      Int
  type        LoyaltyPointType
  bookingId   String?           @map("booking_id") @db.Uuid
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("loyalty_points")
}

model Profile {
  id                      String   @id @db.Uuid
  email                   String
  fullName                String?  @map("full_name")
  phone                   String?
  role                    UserRole @default(guest)
  notificationPreferences Json     @default("{\"email\": true, \"sms\": false}") @map("notification_preferences")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("profiles")
}

// =============================================
// CONTENT MANAGEMENT
// =============================================

model ContentSection {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key        String   @unique
  payload    Json
  status     String   @default("draft")
  version    Int      @default(1)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz

  revisions ContentRevision[]

  @@map("content_sections")
}

model ContentRevision {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sectionId   String   @map("section_id") @db.Uuid
  key         String
  payload     Json
  version     Int
  publishedBy String?  @map("published_by") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  section ContentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("content_revisions")
}

model MenuItem {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  label     String
  href      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  content   String?
  mapEmbed  String?  @map("map_embed")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("menu_items")
}

model Setting {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("settings")
}

